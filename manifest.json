{
  "manifest_version": 3,
  "name": "SideRail",
  "version": "0.26.0",
  "key": "",
  "description": "Vertical tabs, workspaces, command palette and session rewind in the side panel. Nothing leaves your browser.",
  "homepage_url": "https://github.com/RobinLandy/SideRail",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "tabGroups",
    "sidePanel",
    "storage",
    "alarms"
  ],
  "optional_permissions": [
    "bookmarks",
    "history",
    "scripting"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "SideRail — vertical tabs & workspaces",
    "default_icon": {
      "16": "icons/toolbar16-flat.png",
      "32": "icons/toolbar32-flat.png",
      "48": "icons/toolbar48-flat.png",
      "128": "icons/toolbar128-flat.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Alt+B",
        "mac": "Command+Shift+B"
      },
      "description": "Open the SideRail panel"
    },
    "group-by-domain": {
      "suggested_key": {
        "default": "Alt+G",
        "mac": "Command+Shift+G"
      },
      "description": "Group tabs by domain"
    },
    "ungroup-all": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Ungroup all tabs"
    }
  }
}
